[Desktop Entry]
Type=Application
Name=Wordsmith Book
GenericName=Book Production
Comment=Make print and ebook editions of a finished book
Exec=wordsmith-book %f
Icon=org.jcjfoundation.book
Terminal=false
Categories=Office;Publishing;
MimeType=application/x-wordsmith-book;application/x-wordsmith-book-packed;
StartupWMClass=org.jcjfoundation.book
