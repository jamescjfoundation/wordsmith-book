<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-wordsmith-book-packed">
    <comment>Wordsmith Book project (one file)</comment>
    <sub-class-of type="application/zip"/>
    <magic priority="60">
      <match type="string" offset="30" value="mimetypeapplication/x-wordsmith-book-packed"/>
    </magic>
    <glob pattern="*.wsbkz"/>
  </mime-type>
  <mime-type type="application/x-wordsmith-book">
    <comment>Wordsmith Book project</comment>
    <sub-class-of type="inode/directory"/>
    <glob pattern="*.wsbk"/>
  </mime-type>
</mime-info>
